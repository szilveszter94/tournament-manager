model TournamentPhase {
  id           Int       @id @default(autoincrement())
  tournamentId Int
  name         String
  phaseType    PhaseType
  order        Int
  isCompleted  Boolean   @default(false)

  elimination Elimination?
  groups      TournamentGroup[]
  matches     Match[]

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}
