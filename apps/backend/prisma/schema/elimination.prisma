model Elimination {
  id                Int             @id @default(autoincrement())
  tournamentPhaseId Int             @unique
  type              EliminationType @default(Knockout)
  currentRound      Int             @default(1)
  isOver            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  tournamentPhase TournamentPhase @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  matches         Match[]

  @@index([type, currentRound])
}
