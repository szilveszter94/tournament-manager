model TournamentGroup {
  id                  Int      @id @default(autoincrement())
  name                String
  tournamentPhaseId   Int
  groupNumber         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  tournamentPhase   TournamentPhase    @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  participantGroups ParticipantGroup[]
  matches           Match[]

  @@unique([tournamentPhaseId, groupNumber])
  @@index([tournamentPhaseId])
}
