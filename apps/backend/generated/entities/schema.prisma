generator client {
  provider   = "prisma-generator-nestjs-dto"
  output     = "../../frontend/src/interfaces"
  outputType = "interface"
}

generator backend {
  provider = "prisma-client-js"
  output   = "../generated/entities"
}

generator prismaEnum {
  provider = "prisma-generator-enum"
  output   = "../../frontend/src/interfaces/enums.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
