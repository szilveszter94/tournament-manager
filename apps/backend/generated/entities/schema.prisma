enum KnockoutMatchType {
  None
  Final
  SemiFinal
  ThirdPlace
}

model Match {
  id                       Int               @id @default(autoincrement())
  tournamentId             Int
  player1Id                Int?
  player2Id                Int?
  winnerId                 Int?
  serialNumber             Int?
  isOver                   Boolean           @default(false)
  group                    Int?
  isKnockoutMatch          Boolean           @default(false)
  knockoutRound            Int?
  knockoutMatchType        KnockoutMatchType @default(None)
  isDoubleEliminationMatch Boolean           @default(false)
  isWinnersBracketMatch    Boolean           @default(false)
  nextMatchId              Int?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  //Relations
  Tournament            Tournament              @relation(fields: [tournamentId], references: [id])
  Player1               Player?                 @relation("Player1Relation", fields: [player1Id], references: [id])
  Player2               Player?                 @relation("Player2Relation", fields: [player2Id], references: [id])
  Winner                Player?                 @relation("WinnerRelation", fields: [winnerId], references: [id])
  TournamentElimination TournamentElimination[]
}

model Player {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  overallWins   Int      @default(0)
  overallLosses Int      @default(0)
  group         Int?
  elo           Int      @default(1500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  //Relations
  TournamentWinner       TournamentWinner[]
  WinnersByeEliminations TournamentElimination[] @relation("WinnersByePlayerRelation")
  LosersByeEliminations  TournamentElimination[] @relation("LosersByePlayerRelation")
  PlayerTournament       PlayerTournament[]
  MatchPlayer1           Match[]                 @relation("Player1Relation")
  MatchPlayer2           Match[]                 @relation("Player2Relation")
  MatchWinner            Match[]                 @relation("WinnerRelation")
}

model PlayerTournament {
  id           Int      @id @default(autoincrement())
  playerId     Int
  tournamentId Int
  wins         Int      @default(0)
  losses       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  //Relations
  Tournament Tournament @relation(fields: [tournamentId], references: [id])
  Player     Player     @relation(fields: [playerId], references: [id])
}

enum TournamentStat {
  Setup
  FirstRounds
  NormalEliminations
  DoubleEliminations
  Over
}

model Tournament {
  id                 Int            @id @default(autoincrement())
  name               String
  tournamentStat     TournamentStat @default(Setup)
  isFirstRoundsValid Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  //Relations
  TournamentWinner      TournamentWinner[]
  TournamentElimination TournamentElimination[]
  TournamentGroup       TournamentGroup[]
  PlayerTournament      PlayerTournament[]
  Match                 Match[]
}

enum EliminationType {
  Knockout
  Double
}

model TournamentElimination {
  id                        Int             @id @default(autoincrement())
  tournamentId              Int
  currentRound              Int             @default(1)
  eliminationType           EliminationType @default(Knockout)
  bronzeMatchId             Int?
  isLosersBracketPlayerWins Boolean         @default(false)
  isEliminationsOver        Boolean         @default(false)
  winnersBracketByePlayerId Int?
  losersBracketByePlayerId  Int?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  //Relations
  Tournament              Tournament @relation(fields: [tournamentId], references: [id])
  BronzeMatch             Match?     @relation(fields: [bronzeMatchId], references: [id])
  WinnersBracketByePlayer Player?    @relation("WinnersByePlayerRelation", fields: [winnersBracketByePlayerId], references: [id])
  LosersBracketByePlayer  Player?    @relation("LosersByePlayerRelation", fields: [losersBracketByePlayerId], references: [id])
}

model TournamentGroup {
  id                  Int      @id @default(autoincrement())
  tournamentId        Int
  groupNumber         Int
  isGroupMatchesEnded Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  //Relations
  Tournament Tournament @relation(fields: [tournamentId], references: [id])
}

model TournamentWinner {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  playerId     Int
  place        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  //Relations
  Tournament Tournament @relation(fields: [tournamentId], references: [id])
  Player     Player     @relation(fields: [playerId], references: [id])
}

