enum DoubleEliminationBracket {
  Winner
  Loser
  Eliminated
}

enum MatchType {
  DoubleElimination
  Group
  Knockout
  Bronze
  Final
}

enum PhaseType {
  None
  GroupStage
  SingleElimination
  DoubleElimination
  RoundRobin
  Swiss
}

enum ParticipantType {
  Individual
  Team
}

enum TournamentStatus {
  RegisterPlayers
  GroupStage
  GroupStageCompleted
  SingleElimination
  SingleEliminationCompleted
  DoubleElimination
  DoubleEliminationCompleted
  RoundRobin
  RoundRobinCompleted
  Swiss
  SwissCompleted
  Over
}

model Match {
  id                            Int       @id @default(autoincrement())
  tournamentPhaseId             Int
  knockoutId                    Int?
  tournamentGroupId             Int?
  tournamentDoubleEliminationId Int?
  doubleEliminationRound        Int?
  participant1Id                Int?
  participant2Id                Int?
  winnerId                      Int?
  loserId                       Int?
  nextMatchId                   Int?
  serialNumber                  Int?
  winnerElo                     Int?
  loserElo                      Int?
  eloWon                        Int?
  eloLost                       Int?
  isOver                        Boolean   @default(false)
  matchType                     MatchType
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  // Relations
  tournamentPhase   TournamentPhase              @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  knockout          TournamentKnockout?          @relation(fields: [knockoutId], references: [id], onDelete: SetNull)
  group             TournamentGroup?             @relation(fields: [tournamentGroupId], references: [id], onDelete: SetNull)
  doubleElimination TournamentDoubleElimination? @relation(fields: [tournamentDoubleEliminationId], references: [id], onDelete: SetNull)

  participant1 Participant? @relation("MatchParticipant1", fields: [participant1Id], references: [id], onDelete: SetNull)
  participant2 Participant? @relation("MatchParticipant2", fields: [participant2Id], references: [id], onDelete: SetNull)
  winner       Participant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loser        Participant? @relation("MatchLoser", fields: [loserId], references: [id], onDelete: SetNull)

  // Self relation for brackets flow
  nextMatch   Match?  @relation("NextMatch", fields: [nextMatchId], references: [id], onDelete: SetNull)
  prevMatches Match[] @relation("NextMatch")

  @@unique([tournamentGroupId, serialNumber])
  @@index([tournamentPhaseId, matchType])
  @@index([knockoutId])
  @@index([tournamentGroupId])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([winnerId])
}

model Participant {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  type      ParticipantType
  elo       Int             @default(1500)
  wins      Int             @default(0)
  losses    Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  tournaments        ParticipantTournament[]
  doubleEliminations ParticipantDoubleElimination[]
  groups             ParticipantGroup[]
  matchesAsP1        Match[]                        @relation("MatchParticipant1")
  matchesAsP2        Match[]                        @relation("MatchParticipant2")
  matchesWon         Match[]                        @relation("MatchWinner")
  matchesLost        Match[]                        @relation("MatchLoser")
  podiums            TournamentWinner[]

  @@index([name])
}

model ParticipantDoubleElimination {
  id                            Int                      @id @default(autoincrement())
  tournamentDoubleEliminationId Int
  participantId                 Int
  wins                          Int                      @default(0)
  losses                        Int                      @default(0)
  doubleEliminationBracket      DoubleEliminationBracket @default(Winner)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  // Relations
  elimination TournamentDoubleElimination @relation(fields: [tournamentDoubleEliminationId], references: [id], onDelete: Cascade)
  participant Participant                 @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([tournamentDoubleEliminationId, participantId])
  @@index([participantId])
}

model ParticipantGroup {
  id                Int      @id @default(autoincrement())
  tournamentGroupId Int
  participantId     Int
  wins              Int      @default(0)
  losses            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  group       TournamentGroup @relation(fields: [tournamentGroupId], references: [id], onDelete: Cascade)
  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([tournamentGroupId, participantId])
  @@index([participantId])
}

model ParticipantTournament {
  id            Int      @id @default(autoincrement())
  participantId Int
  tournamentId  Int
  wins          Int      @default(0)
  losses        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, tournamentId])
  @@index([participantId])
  @@index([tournamentId])
}

model Tournament {
  id        Int              @id @default(autoincrement())
  name      String
  status    TournamentStatus @default(RegisterPlayers)
  type      ParticipantType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  phases       TournamentPhase[]
  participants ParticipantTournament[]
  winners      TournamentWinner[]

  @@index([name])
}

model TournamentDoubleElimination {
  id                Int      @id @default(autoincrement())
  tournamentPhaseId Int      @unique
  roundNumber       Int      @default(1)
  isActive          Boolean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  tournamentPhase               TournamentPhase                @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  participantDoubleEliminations ParticipantDoubleElimination[]
  matches                       Match[]

  @@unique([tournamentPhaseId, roundNumber])
  @@index([tournamentPhaseId])
}

model TournamentGroup {
  id                Int      @id @default(autoincrement())
  name              String
  tournamentPhaseId Int
  groupNumber       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  tournamentPhase   TournamentPhase    @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  participantGroups ParticipantGroup[]
  matches           Match[]

  @@unique([tournamentPhaseId, groupNumber])
  @@index([tournamentPhaseId])
}

model TournamentKnockout {
  id                Int      @id @default(autoincrement())
  tournamentPhaseId Int      @unique
  currentRound      Int      @default(1)
  isOver            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  tournamentPhase TournamentPhase @relation(fields: [tournamentPhaseId], references: [id], onDelete: Cascade)
  matches         Match[]

  @@index(currentRound)
}

model TournamentPhase {
  id           Int       @id @default(autoincrement())
  tournamentId Int
  phaseType    PhaseType
  order        Int
  isCompleted  Boolean   @default(false)

  knockout          TournamentKnockout?
  groups            TournamentGroup[]
  doubleElimination TournamentDoubleElimination?
  matches           Match[]

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}

model TournamentWinner {
  id            Int      @id @default(autoincrement())
  tournamentId  Int
  participantId Int
  place         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tournament  Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, place])
  @@index([tournamentId])
}

