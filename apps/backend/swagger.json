  "components": {
    "schemas": {
      "TournamentStatus": {
        "type": "string",
        "enum": [
          "RegisterPlayers",
          "CreateFirstRound",
          "FirstRoundStarted",
          "CreateSecondRound",
          "SecondRoundStarted",
          "Over"
        ]
      },
      "ParticipantType": {
        "type": "string",
        "enum": [
          "Individual",
          "Team"
        ]
      },
      "PhaseType": {
        "type": "string",
        "enum": [
          "None",
          "GroupStage",
          "SingleElimination",
          "DoubleElimination",
          "RoundRobin",
          "Swiss"
        ]
      },
      "EliminationType": {
        "type": "string",
        "enum": [
          "Knockout",
          "Double"
        ]
      },
      "MatchType": {
        "type": "string",
        "enum": [
          "Group",
          "Knockout",
          "Bronze",
          "Final"
        ]
      },
      "ParticipantTournament": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "tournamentId": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tournament": {
            "$ref": "#/components/schemas/Tournament"
          },
          "participant": {
            "$ref": "#/components/schemas/Participant"
          }
        },
        "required": [
          "id",
          "participantId",
          "tournamentId",
          "wins",
          "losses",
          "createdAt",
          "updatedAt"
        ]
      },
      "TournamentWinner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "tournamentId": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "place": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tournament": {
            "$ref": "#/components/schemas/Tournament"
          },
          "participant": {
            "$ref": "#/components/schemas/Participant"
          }
        },
        "required": [
          "id",
          "tournamentId",
          "participantId",
          "place",
          "createdAt",
          "updatedAt"
        ]
      },
      "Participant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ParticipantType"
              }
            ]
          },
          "elo": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tournaments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantTournament"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantGroup"
            }
          },
          "matchesAsP1": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "matchesAsP2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "matchesWon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "matchesLost": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "podiums": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TournamentWinner"
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "elo",
          "wins",
          "losses",
          "createdAt",
          "updatedAt"
        ]
      },
      "ParticipantGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "tournamentGroupId": {
            "type": "integer",
            "format": "int32"
          },
          "participantId": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "points": {
            "type": "integer",
            "format": "int32"
