{
  "name": "tournament-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "migrate-db": "npm --workspace=backend exec prisma migrate dev",
    "format-db": "npm --workspace=backend exec prisma format",
    "generate-client": "npm --workspace=backend run prisma:generate",
    "test-api": "npm --workspace=backend run test",
    "seed-db": "npm --workspace=backend run seed-db",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
